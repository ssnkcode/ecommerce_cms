# ============================================================
#  Configuración del frontend (CMS + catálogo)
#  Copiá este archivo a `.env` solo si querés sobreescribir valores.
# ============================================================

# URL base de la API del CMS en producción (back Vercel).
# Sin barras al final. Si se deja vacío, el frontend usa localhost:3001 (dev).
# En el build de producción (Vercel/Cloudflare Pages) también se puede definir
# como variable de entorno del proyecto en vez de este archivo.
VITE_API_URL=https://TU-BACKEND.vercel.app


