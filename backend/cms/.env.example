# ============================================================
#  Configuración del backend del CMS
#  Copiá este archivo a `.env` y ajustá los valores.
# ============================================================

# --- Base de datos ---
# Local (desarrollo): creá vos la base o corré `npm run db:init`
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_cms
#
# Supabase (producción): pegá el connection string de tu proyecto
# (Project Settings > Database > Connection string, modo "Transaction").
# Incluye sslmode=require por defecto, es seguro usarlo tal cual:
# DATABASE_URL=postgresql://postgres.XXXXXX:TU-CONTRASEÑA@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_cms

# --- API ---
# Puerto local (Vercel usa el suyo automáticamente)
PORT=3001

# Orígenes permitidos por CORS en producción, separados por comas.
# Reescribe SIEMPRE el default: si lo dejás vacío, solo funciona en localhost.
# Ejemplos:
# ALLOWED_ORIGINS=https://mi-tienda.pages.dev,https://mi-tienda.com
# Wildcard de subdominio: ALLOWED_ORIGINS=https://*.pages.dev
ALLOWED_ORIGINS=

# --- Sesión ---
# Duración de la sesión (cookie httpOnly) en horas
SESSION_TTL_HOURS=168

# En producción (HTTPS) ponela en 'true' para cookies seguras
COOKIE_SECURE=false

# --- Correo (registro / recuperación de contraseña) ---
# URL pública del catálogo, se usa en los enlaces de los correos (verificar/recuperar).
# En desarrollo apunta al dev server; en producción, a tu dominio (Cloudflare Pages).
FRONTEND_URL=http://localhost:5178/catalog/catalog.html

# SMTP para enviar los correos.
# - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
#   SMTP_USER tiene que ser tu gmail (ssnkcode@gmail.com) y SMTP_PASS una
#   CONTRASEÑA DE APLICACIÓN de Google (16 letras, sin espacios). No va la
#   contraseña normal de la cuenta.
# - Si SMTP_HOST está vacío, el backend NO envía mails reales: loguea el
#   contenido por consola y devuelve el enlace en la API (devLink) para probar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente visible y respuesta. Por defecto es "SsnkCode <SMTP_USER>".
# MAIL_FROM=SsnkCode <ssnkcode@gmail.com>
# Para que sea `solo envío` (no recibir respuestas), setea aquí una dirección
# que no se lea, p. ej.:
# MAIL_REPLY_TO=no-reply@ssnkcode.com

# --- Admin inicial (opcional) ---
# No hay usuario por defecto. Si este backend arranca contra una base vacía y
# querés sembrar un admin automáticamente, definí ADMIN_USER y ADMIN_PASSWORD.
# No dejar estos valores con credenciales débiles/por defecto.
# ADMIN_USER=
# ADMIN_PASSWORD=