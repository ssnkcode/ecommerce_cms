# ============================================================
#  Configuración del backend del CMS
#  Copiá este archivo a `.env` y ajustá los valores.
# ============================================================

# Página local de PostgreSQL (creá vos la base o corré `npm run db:init`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_cms

# Puerto de la API del CMS (3000 suele estar ocupado por otras apps locales)
PORT=3001

# Duración de la sesión (cookie httpOnly) en horas
SESSION_TTL_HOURS=168

# Usuario/contraseña del admin inicial (se crea con `npm run db:init`)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# En producción con HTTPS ponela en 'true' para cookies seguras
COOKIE_SECURE=false